# Google Gemini API Keys from Google AI Studio (https://aistudio.google.com/)
GEMINI_TEXT_API_KEY=your_gemini_api_key_here
GEMINI_IMAGE_API_KEY=your_gemini_api_key_here
# Or single unified key:
# GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Configuration
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2

# Flask secret key for sessions and flash messages
FLASK_SECRET_KEY=lost-and-found-secure-session-key

# Admin Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=myAdmin@20

# Matching Pipeline Thresholds (Range: 0.0 to 1.0)
DESCRIPTION_SIMILARITY_THRESHOLD=0.40
METADATA_SIMILARITY_THRESHOLD=0.50
IMAGE_SIMILARITY_THRESHOLD=0.80
